{
  "id": "batch-scheduler",
  "name": "Batch scheduler fixture",
  "kind": "package",
  "version": "1.0.0",
  "description": "Test scheduler: the host's scheduler contract without any external command.",
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "batch",
      "kind": "scheduler",
      "entry_point": "scheduler.py:Scheduler",
      "scheduler_api": 2,
      "contribution_api": 1,
      "readiness": {"config": ["site.connection.host", "site.connection.remote_root"]},
      "contributions": [
        {"id": "setup", "slot": "settings.site", "availability": "enabled", "entry_point": "settings.py:create_settings"},
        {"id": "launch", "slot": "commands.site", "availability": "ready"},
        {"id": "scheduler-monitor", "slot": "monitor.scheduler", "availability": "ready"}
      ]
    }
  ],
  "payload": {"implementations": ["__init__.py", "scheduler.py", "settings.py"], "resources": [], "configs": {}}
}
