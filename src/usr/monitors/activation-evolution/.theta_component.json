{
  "id": "activation-evolution",
  "name": "Activation Evolution",
  "kind": "monitor",
  "version": "0.1.0",
  "storage_version": 2,
  "api_version": 1,
  "description": "Tracks activation distributions, effective rank and representation similarity on fixed probes.",
  "author": {
    "name": "Theta Research"
  },
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "dependencies": {
    "pip": [
      "numpy",
      "torch"
    ],
    "components": []
  },
  "parameter_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "layers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "max_features": {
        "type": "integer",
        "default": 128,
        "minimum": 1,
        "maximum": 512
      },
      "max_layers": {
        "type": "integer",
        "default": 16,
        "minimum": 1,
        "maximum": 32
      }
