        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string",
            "const": "activation-evolution"
          },
          "params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "max_features": {
                "type": "integer",
                "default": 128,
                "minimum": 1,
                "maximum": 512
              },
              "max_layers": {
                "type": "integer",
                "default": 16,
                "minimum": 1,
                "maximum": 32
              }
            }
          }
        }
      }
    }
  },
  "capabilities": [
    {
      "id": "activation-evolution",
      "kind": "monitor",
      "entry_point": "monitor.py:ActivationEvolution",
      "requires": [
        "probe_forward.v1",
        "post_update.v1"
