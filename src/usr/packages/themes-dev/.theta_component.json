{
  "id": "themes-dev",
  "name": "THEMES source audit and experimental integrations",
  "description": "Original source mirrored verbatim; original training gated; historical demo requires explicit selection.",
  "kind": "suite",
  "version": "0.1.0",
  "storage_version": 2,
  "api_version": 1,
  "origin": "user",
  "capabilities": [
    {
      "id": "themes-dev/runner",
      "kind": "component",
      "entry_point": "theta_adapter.py:ApprenticeshipRunner",
      "execution_contract": 1
    },
    {
      "id": "themes-dev/em_edm",
      "kind": "algorithm",
      "entry_point": "theta_adapter.py:execute",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1,
      "input_requirements": [
        {
          "slot": "data_module",
          "contract": "themes.trajectories/v1"
        }
      ],
      "monitoring": {
        "supports": [
          "scalars.v1",
          "system.v1",
          "numerical_round.v1"
        ],
        "catalog": "monitor_catalog.py:outputs"
      }
    },
    {
      "id": "themes-dev/ticc",
      "kind": "model",
      "entry_point": "themes_al/core.py:MultiSeriesTICC",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1
    },
    {
      "id": "themes-dev/trajectories",
      "kind": "datamodule",
      "entry_point": "theta_adapter.py:TrajectorySource",
      "role": "training",
      "output_contracts": [
        "themes.trajectories/v1"
      ],
      "paradigms": [
        "apprenticeship"
      ]
    },
    {
      "id": "themes-dev/recorded_actions",
      "kind": "evaluator",
      "entry_point": "themes_al/demo.py:export_results",
      "paradigms": [
        "apprenticeship"
      ]
    },
    {
      "id": "themes-dev/csv_trajectories",
      "kind": "datamodule",
      "entry_point": "csv_loader.py:ThemesCsvLoader",
      "role": "training",
      "output_contracts": [
        "themes.trajectories/v1"
      ],
      "paradigms": [
        "apprenticeship"
      ],
      "parameter_schema": {
        "type": "object",
        "properties": {
          "visit_column": {
            "type": "string"
          },
          "time_column": {
            "type": "string"
          },
          "action_column": {
            "type": "string"
          },
          "feature_columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "person_column": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_fraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "themes-dev/themes",
      "kind": "plotter",
      "entry_point": "themes_plotter.py:ThemesPlotter",
      "paradigms": [
        "apprenticeship"
      ]
    },
    {
      "id": "themes-dev/bundle",
      "kind": "model",
      "entry_point": "numerical_models.py:ThemesModels",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1,
      "output_contracts": [
        "themes.models/v1"
      ]
    },
    {
      "id": "themes-dev/dense_policy",
      "kind": "model",
      "entry_point": "themes_al/models.py:DensePolicy",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1
    },
    {
      "id": "themes-dev/themes",
      "kind": "algorithm",
      "entry_point": "theta_adapter.py:execute",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1,
      "input_requirements": [
        {
          "slot": "data_module",
          "contract": "themes.trajectories/v1"
        }
      ],
      "monitoring": {
        "supports": [
          "scalars.v1",
          "system.v1",
          "numerical_round.v1"
        ],
        "catalog": "monitor_catalog.py:outputs"
      }
    },
    {
      "id": "themes-dev/rmt_ticc",
      "kind": "model",
      "entry_point": "themes_al/rmt_ticc.py:RewardTICC",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1
    },
    {
      "id": "themes-dev/tabular_reward",
      "kind": "model",
      "entry_point": "themes_al/rmt_ticc.py:TabularReward",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1
    },
    {
      "id": "themes-dev/time_csv_trajectories",
      "kind": "datamodule",
      "entry_point": "time_loader.py:ThemesTimeCsvLoader",
      "role": "training",
      "output_contracts": [
        "themes.trajectories/v1",
        "themes.temporal/v1"
      ],
      "paradigms": [
        "apprenticeship"
      ],
      "parameter_schema": {
        "type": "object",
        "properties": {
          "visit_column": {
            "type": "string"
          },
          "time_column": {
            "type": "string"
          },
          "action_column": {
            "type": "string"
          },
          "feature_columns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "person_column": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_fraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "window_minutes": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lag_rows": {
            "type": "integer",
            "minimum": 0
          },
          "policy_scaling": {
            "enum": [
              "train_minmax_zero_one",
              "train_minmax_minus_one_one"
            ]
          },
          "clip_policy_inputs": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "themes-dev/full_bundle",
      "kind": "model",
      "entry_point": "numerical_models.py:ThemesModels",
      "paradigms": [
        "apprenticeship"
      ],
      "backend": "numerical",
      "execution_contract": 1,
      "output_contracts": [
        "themes.models/v1"
      ]
    },
    {
      "id": "themes-dev/themes_full",
      "kind": "plotter",
      "entry_point": "themes_plotter.py:ThemesFullPlotter",
      "paradigms": [
        "apprenticeship"
      ]
    }
  ],
