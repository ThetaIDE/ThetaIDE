{
  "id": "arc-site",
  "name": "arc",
  "kind": "site",
  "version": "1.0.0",
  "storage_version": 2,
  "api_version": 1,
  "capabilities": [
    {
      "id": "arc",
      "kind": "site",
      "entry_point": "site.py:SITE"
    }
  ],
  "config_paths": [
    "in/config/site/arc/_defaults.yaml",
    "in/config/site/arc/default.yaml"
  ],
  "payload": {
    "implementations": [
      "site.py"
    ],
    "resources": [
      "ssh_config"
    ],
    "configs": {
      "in/config/site/arc/_defaults.yaml": "configs/site/arc/_defaults.yaml",
      "in/config/site/arc/default.yaml": "configs/site/arc/default.yaml"
    }
  }
}
