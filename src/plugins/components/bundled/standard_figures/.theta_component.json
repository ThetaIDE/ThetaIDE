{
 "kind": "plotter",
 "id": "standard_figures",
 "name": "standard_figures",
 "version": "1.2.0",
 "storage_version": 3,
 "api_version": 1,
 "capabilities": [
  {
   "id": "convergence",
   "kind": "plotter",
   "entry_point": "convergence.py:ConvergencePlotter",
   "label": "Learning curve",
   "description": "A metric over training: each method's mean across runs with an uncertainty band, optionally every run.",
   "provides": [
    "figure/vega-lite-v1"
   ],
   "parameter_schema": {
    "type": "object",
    "properties": {
     "metric": {
      "type": "string",
      "default": "eval/reward",
      "x-theta-metric": true,
      "description": "The logged metric to plot.",
      "x-theta-group": "Data"
     },
     "methods": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "x-theta-method": true,
      "description": "Methods to show; empty shows every method that logged the metric.",
      "x-theta-group": "Data"
     },
     "x_quantity": {
      "type": "string",
      "enum": [
       "transitions",
       "step",
       "epoch",
       "time/total"
      ],
      "default": "transitions",
      "description": "The x axis. A run that did not log it falls back to steps, epochs or the logged point.",
      "x-theta-group": "Data"
     },
     "smoothing": {
      "type": "string",
      "enum": [
       "moving_average",
       "ema",
       "none"
      ],
      "default": "moving_average",
      "description": "How each run is smoothed before runs are combined.",
      "x-theta-group": "Data"
     },
     "smoothing_window": {
      "type": "integer",
      "minimum": 1,
      "default": 10,
      "description": "Smoothing window in logged points; the EMA uses alpha = 2 / (window + 1).",
      "x-theta-group": "Data"
     },
     "band": {
      "type": "string",
      "enum": [
       "sem",
       "ci95",
       "std",
       "none"
      ],
      "default": "sem",
      "description": "Uncertainty across runs: standard error, 95% interval of the mean, standard deviation, or none.",
      "x-theta-group": "Data"
     },
     "show_runs": {
      "type": "boolean",
      "default": false,
      "description": "Also draw every run faintly.",
      "x-theta-group": "Data"
     },
     "x_label": {
      "type": "string",
      "default": "",
      "description": "x-axis title; empty shows the default.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "y_label": {
      "type": "string",
      "default": "",
      "description": "y-axis title; empty shows the default.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "y_scale": {
      "type": "string",
      "enum": [
       "linear",
       "log",
       "symlog"
      ],
      "default": "linear",
      "description": "The y scale. Log hides values at or below zero; symlog keeps them.",
      "x-theta-group": "Axes"
     },
     "y_min": {
      "type": [
       "number",
       "null"
      ],
      "default": null,
      "description": "Lower end of the y axis; empty fits the data.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "y_max": {
      "type": [
       "number",
       "null"
      ],
      "default": null,
      "description": "Upper end of the y axis; empty fits the data.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "title": {
      "type": "string",
      "default": "",
      "description": "Figure title; empty shows the experiment and metric.",
      "x-theta-live": true,
      "x-theta-group": "Style"
     },
     "line_width": {
      "type": "number",
      "minimum": 0,
      "default": 2,
      "description": "Line width in pixels.",
      "x-theta-live": true,
      "x-theta-group": "Style"
     },
     "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "Opacity of the main marks.",
      "x-theta-live": true,
      "x-theta-group": "Style"
     },
     "legend": {
      "type": "string",
      "enum": [
       "right",
       "bottom",
       "top",
       "left",
       "none"
      ],
      "default": "right",
      "description": "Where the legend goes, or none.",
      "x-theta-group": "Style"
     }
    }
   }
  },
  {
   "id": "final_performance",
   "kind": "plotter",
   "entry_point": "final_performance.py:FinalPerformancePlotter",
   "label": "Final performance",
   "description": "Each method's final (or best) score across runs as bars, boxes or a strip, with a bootstrap interval.",
   "provides": [
    "figure/vega-lite-v1"
   ],
   "parameter_schema": {
    "type": "object",
    "properties": {
     "metric": {
      "type": "string",
      "default": "eval/reward",
      "x-theta-metric": true,
      "description": "The logged metric to plot.",
      "x-theta-group": "Data"
     },
     "methods": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "uniqueItems": true,
      "default": [],
      "x-theta-method": true,
      "description": "Methods to show; empty shows every method that logged the metric.",
      "x-theta-group": "Data"
     },
     "score": {
      "type": "string",
      "enum": [
       "final",
       "best",
       "lowest"
      ],
      "default": "final",
      "description": "Each run's score: the mean of its last logged points, or its highest or lowest value.",
      "x-theta-group": "Data"
     },
     "final_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 0.1,
      "description": "Fraction of each run's last logged points averaged for the final score.",
      "x-theta-group": "Data"
     },
     "aggregate": {
      "type": "string",
      "enum": [
       "mean",
       "median",
       "iqm"
      ],
      "default": "mean",
      "description": "How runs are summarised per method; IQM is the mean of the middle 50%.",
      "x-theta-group": "Data"
     },
     "interval": {
      "type": "string",
      "enum": [
       "bootstrap95",
       "none"
      ],
      "default": "bootstrap95",
      "description": "A 95% percentile-bootstrap interval of the summary, or none.",
      "x-theta-group": "Data"
     },
     "y_label": {
      "type": "string",
      "default": "",
      "description": "y-axis title; empty shows the default.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "y_min": {
      "type": [
       "number",
       "null"
      ],
      "default": null,
      "description": "Lower end of the y axis; empty fits the data.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "y_max": {
      "type": [
       "number",
       "null"
      ],
      "default": null,
      "description": "Upper end of the y axis; empty fits the data.",
      "x-theta-live": true,
      "x-theta-group": "Axes"
     },
     "chart": {
      "type": "string",
      "enum": [
       "bar",
       "box",
       "strip"
      ],
      "default": "bar",
      "description": "Bars of the summary, box plots of the runs, or the runs as points.",
      "x-theta-group": "Style"
     },
     "show_runs": {
      "type": "boolean",
      "default": true,
      "description": "Draw each run's score as a point.",
      "x-theta-group": "Style"
     },
     "title": {
      "type": "string",
      "default": "",
      "description": "Figure title; empty shows the experiment and metric.",
      "x-theta-live": true,
      "x-theta-group": "Style"
     },
     "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1,
      "description": "Opacity of the main marks.",
      "x-theta-live": true,
      "x-theta-group": "Style"
     },
     "legend": {
      "type": "string",
      "enum": [
       "right",
       "bottom",
       "top",
       "left",
       "none"
      ],
      "default": "right",
      "description": "Where the legend goes, or none.",
      "x-theta-group": "Style"
     }
    }
   }
  },
