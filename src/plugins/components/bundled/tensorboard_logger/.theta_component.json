{
  "id": "tensorboard_logger",
  "name": "TensorBoard run logger",
  "kind": "package",
  "version": "1.1.0",
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "tensorboard",
      "kind": "run_logger",
      "entry_point": "provider.py:create_logger",
      "activation_plugin": "tensorboard",
      "label": "Log to TensorBoard",
      "results": {
        "category": "tensorboard",
        "patterns": [
          "events.out.tfevents*"
        ]
      }
    }
  ],
  "payload": {
    "implementations": [
      "provider.py",
      "__init__.py"
    ],
    "resources": [],
    "configs": {}
  },
  "config_paths": []
}
