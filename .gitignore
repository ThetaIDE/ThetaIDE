# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment
venv/
.venv/
.env

# ThetaIDE desktop app: local run records, notes and appearance settings (per user)
.thetaide/
# Component YAMLs are moved here while their owning component is uninstalled.
.thetaide/retained_configs/

# Private planning notes (kept locally, not shared)
/BACKEND_ASSESSMENT.md
/missionstatement.md
/prompt_notes_sonnet5.md

# Large Data & Logs
# Anchored to the repository root: an unanchored "results/" also hid frontend/results/ (source code).
/results/
out/
logs/
plots/
offline_dataset/
cache/
*.h5
*.pkl
*.pth
*.npz
*.npy
*.csv
*.tsv
*.parquet
*.arrow
*.feather
*.hdf5
*.jsonl

# Training output written outside results/ (ad-hoc scripts, notebooks, other loggers)
lightning_logs/
wandb/
mlruns/
events.out.tfevents.*
*.ckpt
.ipynb_checkpoints/

# OS Specific
.DS_Store
Thumbs.db
desktop.ini
assets/
outputs/
multirun/

# Databases / Optuna
optuna.db
*.db

# Antigravity/Agent customizations
.agents/
scratch/

# Local datasets
in/datasets/
datasets/

# Packaging / Distribution
build/
dist/
*.egg-info/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking & linting
.mypy_cache/
.dmypy.json
.ruff_cache/

# IDE & personal agent settings
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# Leftover artifacts
temp/
.src/

# Component and plugin runtime directories (managed via Hub / local authoring)
/in/envs/*
!/in/envs/.gitkeep
/in/rules/*
!/in/rules/.gitkeep
# Old rules location is unsupported; component payloads use the research tree below.
/in/rules
/src/usr/rules/*
!/src/usr/rules/.gitkeep
/in/config/agent/*
!/in/config/agent/.gitkeep
/in/config/experiment/*
!/in/config/experiment/.gitkeep
/in/config/model/*
!/in/config/model/.gitkeep
/in/config/env/*
!/in/config/env/.gitkeep
/in/config/data/*
!/in/config/data/.gitkeep
/in/config/plot/*
!/in/config/plot/.gitkeep
!/in/config/plot/thetalib/
/in/config/plot/thetalib/*
!/in/config/plot/thetalib/tuning.yaml
/src/usr/methods/*
!/src/usr/methods/.gitkeep
/src/usr/models/*
!/src/usr/models/__init__.py
!/src/usr/models/.gitkeep
# The interpreter the visual model builder targets: infrastructure for a
# built-in feature, not a research model, so it ships rather than installs.
!/src/usr/models/sequential_spec/
!/src/usr/models/blendrl-dev/

# Generated site shortcuts contain local interpreter and workspace paths.
/src/usr/sites/*/bin/

# Managed extensions are per-workspace payloads; bundled source and assets ship.
/src/plugins/components/installed/
/src/plugins/app/installed/
!/src/plugins/app/bundled/**/assets/
# User implementations can be versioned independently; preserve existing per-kind ignore policy.

# Documentation is versioned; allow its media directory despite the general assets/ rule.
!/docs/assets/
